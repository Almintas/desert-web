# Nukopijuok į .env.local. Vercel šiuos nustatai Project Settings → Environment Variables.
# Tik serveryje (ne NEXT_PUBLIC_): naršyklė į API tiesiogiai nesikreipia, užsakymus
# pateikia web serveris (Server Action). Produkcijoje privalomas (be jo serveris nepasileidžia).
API_URL=http://localhost:4000
# Tokia pati reikšmė kaip apps/api INTERNAL_API_SECRET (bent 32 simboliai). Produkcijoje
# privaloma: API POST /orders priima tik su ja, o su ja gauna ir tikrą pirkėjo IP ribojimui.
# Vystant neprivaloma.
INTERNAL_API_SECRET=
# Cloudflare Turnstile site key (Cloudflare → Turnstile → valdiklis, režimas Managed). Įrašomas
# builde, todėl pakeitus reikia perdiegti. Produkcijoje privalomas; vystant tuščias reiškia
# Cloudflare testinį „visada praeina“ raktą 1x00000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Neprivaloma: viešas svetainės adresas absoliutiems OG adresams (pvz., https://desertai.lt).
SITE_URL=
