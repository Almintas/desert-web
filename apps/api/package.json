{
  "name": "@desert-web/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "seed": "node --env-file=.env dist/scripts/seed.js",
    "test": "jest --runInBand",
    "db:indexes": "node --env-file-if-exists=.env dist/scripts/sync-indexes.js",
    "admin:create": "node --env-file-if-exists=.env dist/scripts/create-admin.js",
    "products:add": "node --env-file-if-exists=.env dist/scripts/add-products.js"
  },
  "dependencies": {
    "@desert-web/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.8.0",
    "cloudinary": "^2.11.0",
    "mongoose": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0"
  }
}
