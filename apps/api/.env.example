# Nukopijuok į .env ir užpildyk. Railway šiuos nustatai service Variables skiltyje.

NODE_ENV=development
# Railway PORT nustato pats
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/desert-web?retryWrites=true&w=majority

# Neprivaloma: DB pavadinimas, jei turi skirtis nuo esančio MONGODB_URI (pvz., bendras klasteris
# su kitu projektu). Turi pirmenybę prieš URI kelią.
MONGODB_DB_NAME=

# Kableliais atskirti adresai, iš kurių leidžiama kreiptis į API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Admino sesijos trukmė dienomis (numatyta 7)
ADMIN_SESSION_TTL_DAYS=7
# Prisijungimo bandymų limitas vienam IP per langą (sekundėmis)
ADMIN_LOGIN_RATE_LIMIT=5
ADMIN_LOGIN_RATE_WINDOW_SECONDS=60
# Bendra paslaptis su admin app (tokia pati kaip apps/admin INTERNAL_API_SECRET), bent 32 simboliai.
# Su ja admin app perduoda tikrą naršyklės IP prisijungimų ribojimui. Sugeneruok: openssl rand -base64 32
# Vystant neprivaloma; su NODE_ENV=production API be jos nepasileidžia.
INTERNAL_API_SECRET=

# Cloudflare Turnstile (užsakymų apsauga nuo robotų): Cloudflare → Turnstile → valdiklis → Secret key.
# Su NODE_ENV=production API be jo nepasileidžia. Vystant galima palikti tuščią: tada naudojamas
# Cloudflare testinis „visada praeina“ raktas 1x0000000000000000000000000000000AA
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
TURNSTILE_SECRET_KEY=

# Užsakymų ribojimas vienam pirkėjo IP (numatyta: 5 per 10 min., 20 per parą, peržiūra 60 per min.).
# Paprastai nekeičiama; testai ir e2e nustato savo reikšmes.
# ORDER_RATE_LIMIT_SHORT=5
# ORDER_RATE_WINDOW_SHORT_SECONDS=600
# ORDER_RATE_LIMIT_DAILY=20
# ORDER_RATE_WINDOW_DAILY_SECONDS=86400
# ORDER_ACCESS_RATE_LIMIT=60
# ORDER_ACCESS_RATE_WINDOW_SECONDS=60
# Ar kliento IP imti iš X-Real-IP (Railway jį nustato pats). Numatyta: true tik produkcijoje.
# TRUST_X_REAL_IP=

# Kol kas neprivaloma (prireiks užsakymų laiškams)
RESEND_API_KEY=
EMAIL_FROM=

# Produktų nuotraukos (Cloudinary → Settings → API Keys). Su NODE_ENV=production API be jų
# nepasileidžia; vystant be jų nuotraukų maršrutai grąžina 503 IMAGES_NOT_CONFIGURED.
# Paslapties niekam nerodyk: admin app jos negauna, įkėlimus pasirašo API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Neprivaloma. Numatyta desert-web/<NODE_ENV>/products (vystymo įkėlimai nesimaišo su produkcija).
CLOUDINARY_FOLDER=
