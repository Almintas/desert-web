# Nukopijuok į .env.local. Vercel šiuos nustatai Project Settings → Environment Variables.
# Tik serveryje (ne NEXT_PUBLIC_): naršyklė į API tiesiogiai nesikreipia.
API_URL=http://localhost:4000
# Tokia pati reikšmė kaip apps/api INTERNAL_API_SECRET. Vystant neprivaloma; produkcijoje
# privaloma: be jos prisijungimas atmetamas (kitaip API limitą skaičiuotų visiems adminams bendrai).
INTERNAL_API_SECRET=
