{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "VERCEL_ENV", "SITE_URL", "VERCEL_PROJECT_PRODUCTION_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/eslint-config/*.js",
        "$TURBO_ROOT$/packages/eslint-config/package.json"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
