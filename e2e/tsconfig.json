{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "support/**/*.ts", "support/**/*.mjs"]
}
