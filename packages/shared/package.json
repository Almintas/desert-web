{
  "name": "@desert-web/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Bendri tipai, Zod schemos ir pagalbinės funkcijos (web, admin, api).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
